# GEMINI_API_KEY: Server-side secret key for Google Gemini AI API calls.
# Kept strictly server-side in process.env (never exposed to browser or prefixed with VITE_).
GEMINI_API_KEY=

# ALLOW_MOCK_AI: Set to 'true' ONLY for local offline testing without active API keys.
ALLOW_MOCK_AI=false

# APP_URL: The URL where this applet is hosted.
APP_URL=
